{
  "name": "the-content-architecture-astro",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.6.2"
  },
  "volta": {
    "node": "24.15.0"
  },
  "overrides": {
    "vite": "8.3.6",
    "@sanity/visual-editing": "^6.1.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "astro build && astro preview",
    "check": "concurrently npm:check.*",
    "precheck.types": "npm run sanity:typegen",
    "check.types": "astro check",
    "check.biome": "biome lint --diagnostic-level=error --no-errors-on-unmatched --files-ignore-unknown=true",
    "format": "biome check --write --unsafe",
    "test": "node --import=tsx --test \"scripts/**/*.test.ts\" \"src/**/*.test.ts\" \"sanity/**/*.test.ts\"",
    "plop": "plop",
    "sections:thumbs": "dotenvx run -- node --import=tsx scripts/section-thumbs/capture.ts",
    "trim": "dotenvx run --ignore=MISSING_ENV_FILE -- node --import=tsx scripts/trim-features/trim.ts",
    "trim:verify": "node --import=tsx scripts/trim-features/verify.ts",
    "trim:update": "node --import=tsx scripts/trim-features/update.ts",
    "i18n:check": "node --import=tsx scripts/i18n-check/run.ts",
    "clear": "rm -rf .astro node_modules/.vite dist",
    "sanity:typegen": "dotenvx run -- sh -c \"sanity schema extract --force --path='sanity-schema.json' && sanity typegen generate && sed -i.bak 's/| null/| undefined/g; s/null |/undefined |/g; s/{} |//g; s/| {}//g' sanity/types.ts && rm sanity/types.ts.bak\"",
    "sanity:cli": "dotenvx run -- sanity",
    "sanity:schema-deploy": "dotenvx run -- sanity schema deploy",
    "sanity:schema-check": "dotenvx run --ignore=MISSING_ENV_FILE -- node --import=tsx scripts/sanity-schema-check/check.ts",
    "sanity:dataset-export": "dotenvx run -- node --import=tsx scripts/sanity-dataset/export.ts",
    "sanity:dataset-import": "dotenvx run -- node --import=tsx scripts/sanity-dataset/import.ts",
    "sanity:dataset-migrate": "dotenvx run -- node --import=tsx scripts/sanity-dataset/migrate.ts",
    "sanity:project-setup": "dotenvx run --ignore=MISSING_ENV_FILE -- node --import=tsx scripts/sanity-project-setup/setup.ts",
    "sanity:add-language": "dotenvx run -- node --import=tsx scripts/sanity-migrations/add-language.ts",
    "sanity:migrate-backfill-language": "dotenvx run -- node --import=tsx scripts/sanity-migrations/backfill-language.ts",
    "sanity:migrate-localize-fields": "dotenvx run -- node --import=tsx scripts/sanity-migrations/localize-fields.ts",
    "sanity:migrate-asset-fields": "dotenvx run -- node --import=tsx scripts/sanity-migrations/localize-asset-fields.ts",
    "sanity:migrate-segments": "dotenvx run -- node --import=tsx scripts/sanity-migrations/migrate-segments.ts",
    "sanity:migrate-remove-language": "dotenvx run -- node --import=tsx scripts/sanity-migrations/remove-language.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@astrojs/react": "7.1.2",
    "@dotenvx/dotenvx": "2.38.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lottiefiles/dotlottie-wc": "0.11.1",
    "@lottiefiles/dotlottie-web": "0.82.1",
    "@mux/mux-player": "3.14.1",
    "@portabletext/to-html": "6.0.0",
    "@rive-app/canvas": "2.49.4",
    "@rive-app/canvas-advanced-single": "2.49.4",
    "@sanity/astro": "3.6.0",
    "@sanity/client": "8.14.1",
    "@sanity/document-internationalization": "6.2.46",
    "@sanity/icons": "5.2.3",
    "@sanity/image-url": "2.1.1",
    "@sanity/language-filter": "5.0.23",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/ui": "4.4.10",
    "@sanity/vision": "6.22.0",
    "@sanity/webhook": "4.0.4",
    "astro": "7.4.5",
    "astro-portabletext": "1.0.1",
    "change-case": "5.4.4",
    "kugiri": "0.5.3",
    "lenis": "1.3.27",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "resend": "6.37.0",
    "sanity": "6.22.0",
    "sanity-plugin-internationalized-array": "5.3.9",
    "sanity-plugin-media": "6.6.1",
    "sanity-plugin-mux-input": "5.2.2",
    "sharp": "0.35.5",
    "styled-components": "6.6.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@sanity/codegen": "8.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/prompts": "2.4.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.41.2",
    "commander": "15.0.0",
    "concurrently": "10.0.6",
    "groq-js": "2.0.1",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "ora": "10.0.0",
    "playwright-core": "1.64.1",
    "plop": "4.0.5",
    "prompts": "2.4.2",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
