---
import type { Props as PortableTextNodeProps } from "astro-portabletext/types";
import InnerParallax from "~/components/InnerParallax/InnerParallax.astro";
import { cssAspectRatio } from "~/features/sanity/media/utils";
import SanityMedia from "../../media/SanityMedia.astro";
import type { MediaValue } from "../../media/types";

type Props = PortableTextNodeProps<{
  _type: "mediaBlock";
  media?: MediaValue;
  caption?: string | null;
  useParallax?: boolean | null;
}>;

const { node } = Astro.props;
---

<figure class="flex flex-col gap-12 pt-6 group-data-prose/rich:max-w-620" data-rich-text-block="mediaBlock">
  {
    node.useParallax ? (
      <InnerParallax
        overflow="60 lg:120"
        class="media-frame"
        style={{ aspectRatio: cssAspectRatio(node.media?.aspectRatio) }}
      >
        <SanityMedia media={node.media} class="size-full object-cover" />
      </InnerParallax>
    ) : (
      <div class="media-frame">
        <SanityMedia media={node.media} class="w-full" />
      </div>
    )
  }
  {node.caption && <figcaption class="font-mono text-caption whitespace-pre-line text-ink-muted">{node.caption}</figcaption>}
</figure>
