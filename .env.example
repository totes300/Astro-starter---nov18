# Canonical site origin (protocol, no trailing slash).
PUBLIC_SITE_URL=http://localhost:4321

# Sanity project (public; `npm run sanity:project-setup` fills these).
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-02-19

# Public route the embedded Studio mounts at (must start with "/", no trailing slash).
PUBLIC_SANITY_STUDIO_BASE_PATH=/studio

# Server-only Sanity tokens (never reach the browser); `npm run sanity:project-setup` creates both.
SANITY_API_VIEW_TOKEN=
SANITY_API_EDIT_TOKEN=

# Optional: shared secret for the Sanity publish webhook (/api/revalidate). Leave unset to skip the webhook.
# `npm run sanity:project-setup` fills it with a random 64-hex value when empty. At least 32 characters when set
# (`openssl rand -hex 32`); a shorter value fails env validation. The webhook uses the same value.
SANITY_REVALIDATE_SECRET=

# Optional: HTTP Basic Auth; the toggles live in Sanity.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Optional: the Studio's Redeploy site button starts the deploy workflow. The token is a fine-grained GitHub
# token for this repository only, with Actions read and write, set as a Worker secret. On the Worker the
# workflow passes DEPLOY_REPOSITORY (owner/repo) with every deploy; set it here only to try the button locally.
DEPLOY_GITHUB_TOKEN=
DEPLOY_REPOSITORY=

# Resend, for contact form notification emails. Optional in dev; required for the feature in production.
RESEND_API_KEY=
RESEND_EMAIL_FROM=

# Umami analytics website id; tracking is disabled when unset.
PUBLIC_UMAMI_WEBSITE_ID=

# Cloudflare Turnstile, the human check every form runs (docs/features/turnstile.md). These are
# Cloudflare's always-pass test keys, right for local runs. Production: the site key is the
# PUBLIC_TURNSTILE_SITE_KEY build variable, the secret is set on the Worker. Without the secret, every
# form submission is refused.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
